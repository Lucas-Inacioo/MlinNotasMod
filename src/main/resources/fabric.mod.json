{
	"schemaVersion": 1,
	"id": "mlinnotas",
	"version": "${version}",
	"name": "Mlin Notas",
	"description": "Anotacoes dentro do Minecraft.",
	"authors": [
		"Lucas Inacio"
	],
	"contact": {
		"sources": "https://github.com/Lucas-Inacioo/MlinNotasMod"
	},
